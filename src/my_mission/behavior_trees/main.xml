<?xml version="1.0"?>

<root BTCPP_format="4" main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <!--
      Real mission. It must be FINITE: it ends in SUCCESS or FAILURE (the
      simulator stops the robot after a successful run).
      Requires the Gazebo world + Nav2 stack up (Gate 3): map, scan, TF and
      the navigate_to_pose action server.
    -->
    <Sequence name="MainTree">
      <GreetNode who="mission"/>

      <WaitForRobotReady
        scan_topic="scan"
        map_frame="map"
        base_frame="base_link"
        timeout="15.0"/>

      <!-- TODO: adjust the goal pose to your mission -->
      <CreatePose
        x="1.0"
        y="0.0"
        yaw="0.0"
        frame_id="map"
        pose="{navigation_goal}"/>

      <NavigateToPose pose="{navigation_goal}"/>

      <GreetNode who="mission complete"/>
    </Sequence>
  </BehaviorTree>
</root>
