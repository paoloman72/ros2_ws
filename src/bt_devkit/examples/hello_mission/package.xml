<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>hello_mission</name>
  <version>0.1.0</version>
  <description>
    Minimal bt_devkit user project: one custom node, two trees.
    Copy this folder to your own workspace (src/) and replace the content
    with your mission.
  </description>

  <maintainer email="maintainer@example.com">maintainer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>bt_devkit</depend>
  <depend>rclcpp</depend>
  <depend>behaviortree_cpp</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
